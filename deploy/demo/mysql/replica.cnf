# MySQL 从库配置（演示主从复制）
[mysqld]
server-id = 2
relay-log = relay-bin
character-set-server = utf8mb4
# SOURCE_AUTO_POSITION=1 要求从库自身也开启 GTID（否则 CHANGE REPLICATION SOURCE 报 ERROR 1777）：
gtid_mode = ON
enforce_gtid_consistency = ON
# 注意：这里不能配 read_only/super_read_only！
# Docker 首次初始化（entrypoint 设 root 密码、执行 init SQL）需要写权限，
# 配在 cnf 里会导致初始化全部失败（root 密码为空、复制不配置，报 ERROR 1290）。
# 只读保护由 replica/init/01-configure-replica.sql 在初始化完成后以 SET GLOBAL 设置。
