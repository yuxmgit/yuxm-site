# ============ 应用基础 ============
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
# CORS 允许的前端来源，备案后改为 https://yuxm.site
FRONTEND_ORIGIN=http://localhost:3000

# ============ 数据库 ============
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=yuxm
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=yuxm_site

# ============ Redis ============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============ JWT ============
# 生产环境务必生成强随机密钥：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-secret
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ============ 管理员种子账号（首次启动创建，上线后必须改密） ============
ADMIN_INIT_USERNAME=yuxiangming
ADMIN_INIT_PASSWORD=yuxiangming

# ============ 腾讯云 SMS（手机验证码登录） ============
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
# 验证码有效期（秒）与发送间隔（秒）
SMS_CODE_EXPIRE_SECONDS=300
SMS_RESEND_INTERVAL_SECONDS=60

# ============ OAuth 第三方登录 ============
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITEE_CLIENT_ID=
GITEE_CLIENT_SECRET=
# OAuth 回调地址，备案后改为 https://yuxm.site/api/auth/{provider}/callback
GITHUB_REDIRECT_URI=http://localhost:3000/server/auth/github/callback
GITEE_REDIRECT_URI=http://localhost:3000/server/auth/gitee/callback
